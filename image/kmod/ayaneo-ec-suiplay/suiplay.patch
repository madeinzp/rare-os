+/*
+ * Rare OS: the EC gets the stick rings and the fan back at power off and reboot. rare-fand hands
+ * the fan back when its service stops; this also covers a shutdown where it did not get to (killed,
+ * or a stop that ran out of time), so the fan never stays at the last speed the OS set.
+ */
+static void ayaneo_shutdown(struct platform_device *pdev)
+{
+	struct ayaneo_ec_platform_data *data = platform_get_drvdata(pdev);
+
+	suiplay_rgb_shutdown(&pdev->dev);
+	if (data && data->quirks->has_fan_control)
+		ec_write(AYANEO_PWM_ENABLE_REG, AYANEO_PWM_MODE_AUTO);
+}
